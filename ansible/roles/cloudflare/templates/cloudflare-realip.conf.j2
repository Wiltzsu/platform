# {{ ansible_managed }}
# Cloudflare real IP restoration
# Ranges: roles/cloudflare/defaults/main.yml (source: https://www.cloudflare.com/ips/)

real_ip_header CF-Connecting-IP;
real_ip_recursive on;

# IPv4
{% for ip in platform_cloudflare_ipv4 %}
set_real_ip_from {{ ip }};
{% endfor %}

# IPv6
{% for ip in platform_cloudflare_ipv6 %}
set_real_ip_from {{ ip }};
{% endfor %}
